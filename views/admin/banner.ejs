<%- include('layout', { admin, page: 'banner' }) %>

<div class="breadcrumb">
  <a href="/admin/banner">Banner</a> <span>&raquo;</span> Reklamni banner v sidebaru
</div>

<% if (typeof saved !== 'undefined' && saved) { %>
  <div class="msg-success">Banner byl ulozen.</div>
<% } %>

<form method="post" action="/admin/banner" class="admin-form">

  <div class="form-group">
    <label>Nadpis banneru:</label>
    <input type="text" name="title" value="<%= banner ? banner.title : 'HOFO' %>" placeholder="HOFO">
  </div>

  <div class="form-group">
    <label>Podnadpis:</label>
    <input type="text" name="subtitle" value="<%= banner ? banner.subtitle : '' %>" placeholder="Studiove projekty">
  </div>

  <div class="form-group">
    <label>Odkaz (klik na banner):</label>
    <input type="url" name="link_url" value="<%= banner ? banner.link_url : '' %>" placeholder="https://hofo.cz">
  </div>

  <h3 style="margin-top:24px;margin-bottom:12px;">Polozky banneru (videa/obrazky)</h3>

  <div id="banner-items">
    <% if (items && items.length) { %>
      <% items.forEach((item, i) => { %>
        <div class="banner-item" style="border:1px solid #ddd;border-radius:8px;padding:16px;margin-bottom:12px;background:#fafafa;">
          <div style="display:flex;gap:12px;align-items:start;">
            <% if (item.image_url) { %>
              <img src="<%= item.image_url %>" style="width:120px;height:68px;object-fit:cover;border-radius:4px;">
            <% } %>
            <div style="flex:1;">
              <div class="form-group" style="margin-bottom:8px;">
                <label>URL obrazku:</label>
                <input type="text" name="item_image" value="<%= item.image_url || '' %>" placeholder="https://...">
              </div>
              <div class="form-group" style="margin-bottom:8px;">
                <label>Titulek:</label>
                <input type="text" name="item_title" value="<%= item.title || '' %>">
              </div>
              <div class="form-group" style="margin-bottom:0;">
                <label>Odkaz:</label>
                <input type="text" name="item_link" value="<%= item.link_url || '' %>" placeholder="https://...">
              </div>
            </div>
            <button type="button" onclick="this.closest('.banner-item').remove()" style="color:#e33;background:none;border:none;cursor:pointer;font-size:18px;">&times;</button>
          </div>
        </div>
      <% }) %>
    <% } %>
  </div>

  <button type="button" onclick="addBannerItem()" class="btn" style="margin-bottom:20px;">+ Pridat polozku</button>

  <div class="form-actions">
    <button type="submit" class="btn btn-green">Ulozit banner</button>
  </div>
</form>

<script>
function addBannerItem() {
  const div = document.createElement('div');
  div.className = 'banner-item';
  div.style = 'border:1px solid #ddd;border-radius:8px;padding:16px;margin-bottom:12px;background:#fafafa;';
  div.innerHTML = `
    <div style="display:flex;gap:12px;align-items:start;">
      <div style="flex:1;">
        <div class="form-group" style="margin-bottom:8px;">
          <label>URL obrazku:</label>
          <input type="text" name="item_image" value="" placeholder="https://...">
        </div>
        <div class="form-group" style="margin-bottom:8px;">
          <label>Titulek:</label>
          <input type="text" name="item_title" value="">
        </div>
        <div class="form-group" style="margin-bottom:0;">
          <label>Odkaz:</label>
          <input type="text" name="item_link" value="" placeholder="https://...">
        </div>
      </div>
      <button type="button" onclick="this.closest('.banner-item').remove()" style="color:#e33;background:none;border:none;cursor:pointer;font-size:18px;">&times;</button>
    </div>
  `;
  document.getElementById('banner-items').appendChild(div);
}
</script>

<%- include('footer') %>
