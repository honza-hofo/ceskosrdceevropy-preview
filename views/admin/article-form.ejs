<%- include('layout', { admin, page: 'articles' }) %>

<div class="breadcrumb">
  <a href="/admin/articles">Články</a> <span>»</span> <%= article ? 'Upravit' : 'Nový článek' %>
</div>

<form method="post" action="/admin/articles<%= article ? '/' + article.id : '' %>" enctype="multipart/form-data" class="admin-form">

  <div class="form-group">
    <label>Název:</label>
    <input type="text" name="title" value="<%= article ? article.title : '' %>" required>
  </div>

  <div class="form-group">
    <label>Kategorie:</label>
    <select name="category" required>
      <% categories.forEach(c => { %>
        <option value="<%= c %>" <%= article && article.category === c ? 'selected' : '' %>><%= c %></option>
      <% }) %>
    </select>
  </div>

  <div class="form-group">
    <label>Autor:</label>
    <input type="text" name="author" value="<%= article ? article.author || '' : '' %>">
  </div>

  <div class="form-group">
    <label>Datum:</label>
    <input type="date" name="published_at" value="<%= article ? article.published_at || '' : new Date().toISOString().split('T')[0] %>">
  </div>

  <div class="form-group">
    <label>Perex:</label>
    <textarea name="perex" rows="3"><%= article ? article.perex || '' : '' %></textarea>
  </div>

  <div class="form-group">
    <label>Obsah:</label>
    <textarea name="content" id="editor" class="mceEditor"><%= article ? article.content || '' : '' %></textarea>
  </div>

  <div class="form-group">
    <label>Obrázek:</label>
    <div>
      <input type="file" name="featured_image" accept="image/*">
      <% if (article && article.featured_image) { %>
        <img src="<%= article.featured_image %>" class="img-preview">
      <% } %>
    </div>
  </div>

  <div class="form-group">
    <label>Publikovat:</label>
    <div class="checkbox-wrap">
      <input type="checkbox" name="is_published" value="1" <%= article && article.is_published ? 'checked' : '' %>>
      <span>Zobrazit na webu</span>
    </div>
  </div>

  <div class="form-actions">
    <button type="submit" class="btn btn-green">Uložit</button>
    <% if (article) { %>
      <a href="/admin/articles/<%= article.id %>/preview" class="btn btn-gray" target="_blank">👁 Náhled</a>
    <% } %>
    <a href="/admin/articles" class="btn btn-gray">Zrušit</a>
  </div>
</form>

<script src="https://cdn.tiny.cloud/1/no-api-key/tinymce/6/tinymce.min.js"></script>
<script>
tinymce.init({
  selector: '#editor',
  language: 'cs',
  height: 500,
  plugins: 'lists link image code fullscreen media table',
  toolbar: 'undo redo | styleselect | bold italic underline | alignleft aligncenter alignright | bullist numlist | link image media | code fullscreen',
  style_formats: [
    {title: 'Nadpis 2', format: 'h2'},
    {title: 'Nadpis 3', format: 'h3'},
    {title: 'Nadpis 4', format: 'h4'},
    {title: 'Odstavec', format: 'p'},
    {title: 'Citace', format: 'blockquote'}
  ],
  menubar: false,
  branding: false,
  relative_urls: false,
  convert_urls: true
});
</script>

<%- include('footer') %>
