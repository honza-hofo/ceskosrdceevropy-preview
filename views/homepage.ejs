<%- include('partials/head') %>
<%- include('partials/header') %>

    <div class="container">
        <div class="page-layout">
            <main>
                <% if (featured) { %>
                <article class="featured-article">
                    <a href="/clanek/<%= featured.slug %>"><img src="<%= featured.featured_image || 'https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=1200&h=800&fit=crop' %>" alt="<%= featured.title %>"></a>
                    <div class="content">
                        <span class="badge badge-<%= featured.category.toLowerCase() %>"><%= featured.category %></span>
                        <h2><a href="/clanek/<%= featured.slug %>"><%= featured.title %></a></h2>
                        <p class="excerpt"><%= featured.perex %></p>
                        <div class="meta">
                            <span class="author"><%= featured.author || 'Redakce' %></span>
                            <span class="sep">|</span>
                            <span><%= featured.published_at || '' %></span>
                        </div>
                    </div>
                </article>
                <% } %>

                <div class="section-heading">Nejnovější články</div>

                <div class="article-grid">
                    <% articles.forEach(a => { %>
                    <article class="article-card">
                        <a href="/clanek/<%= a.slug %>"><img src="<%= a.featured_image || 'https://images.unsplash.com/photo-1504711434969-e33886168d6c?w=800&h=450&fit=crop' %>" alt="<%= a.title %>" loading="lazy"></a>
                        <div class="content">
                            <span class="badge badge-<%= a.category.toLowerCase() %>"><%= a.category %></span>
                            <h3><a href="/clanek/<%= a.slug %>"><%= a.title %></a></h3>
                            <p class="excerpt"><%= a.perex %></p>
                            <div class="meta">
                                <span class="author"><%= a.author || 'Redakce' %></span>
                                <span class="sep">|</span>
                                <span><%= a.published_at || '' %></span>
                            </div>
                        </div>
                    </article>
                    <% }) %>
                </div>

                <%- include('partials/pagination', { currentPage, totalPages, baseUrl: '/?' }) %>
            </main>

            <%- include('partials/sidebar') %>
        </div>
    </div>

<%- include('partials/footer') %>
